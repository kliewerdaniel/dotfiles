# Never track these. chezmoi already only manages what was explicitly `add`ed,
# but these guard against a future blanket `chezmoi add ~/.config`.

# Credentials and tokens
**/hosts.yml
**/.git-credentials
**/*.key
**/*.pem
**/id_rsa*
**/id_ed25519*
**/known_hosts
**/auth.json
**/config.yml.encrypted

# gh CLI stores an oauth token in this file
.config/gh/

# restic repo password — NEVER track. No GPG key is set up on this machine, so
# it cannot be an encrypted template. Regenerate on a new machine and re-init
# the repo, or set up gpg + `chezmoi add --template` first.
.config/restic/password

# Browser + app state: huge, machine-specific, and not configuration
.config/chromium/
.config/chromium-flags.conf
.config/google-chrome*/
.config/BraveSoftware/
.config/microsoft-edge*/
.config/dconf/
# VSCode: track only the hand-written config, never the 100+ MB of caches,
# blob storage, session state, logs, and extension downloads.
# chezmoi's gitignore semantics will not re-include a subpath under an
# ignored parent, so each noisy subdir is listed explicitly instead.
.config/Code/Backups/
.config/Code/Blob Storage/
.config/Code/blob_storage/
.config/Code/Cache/
.config/Code/CachedConfigurations/
.config/Code/CachedData/
.config/Code/CachedExtensionVSIXs/
.config/Code/CachedProfilesData/
.config/Code/Code Cache/
.config/Code/Crashpad/
.config/Code/DawnGraphiteCache/
.config/Code/DawnWebGPUCache/
.config/Code/GPUCache/
.config/Code/Local Storage/
.config/Code/logs/
.config/Code/Session Storage/
.config/Code/User/globalStorage/
.config/Code/User/History/
.config/Code/User/workspaceStorage/
.config/Code/User/snell/
.config/Code/agent-host/
.config/nautilus/
.config/autostart/

# nvim: lockfile is tracked on purpose, but never the plugin/runtime state
.config/nvim/.lazy/
.config/nvim/lazy/
.config/nvim/.cache/

# Editors / OS noise
.config/ghostty/
.config/alacritty/
**/*.bak
**/*.bak.*
**/*~
.DS_Store

# Repo README documents the repo, not this machine — keep it in the source
# dir but never deploy it to $HOME.
README.md

# restic README is documentation for the backup setup — same treatment.
.config/restic/README.md

# Never commit a rendered/scratch dir
.scratch/
